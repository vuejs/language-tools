{
	// Type-checks the services submodule with the repo's TypeScript 7 and the services' own options, minus what TS 7 dropped (`esModuleInterop: false`, implicit `@types`).
	// Its runtime JS is emitted by `npm run build:services` (TypeScript 5.9), as the services publish it.
	"extends": "../services/packages/typescript/tsconfig.json",
	"compilerOptions": {
		"esModuleInterop": null,
		"types": ["node"],
		// The type-only devDependency `@volar/typescript` gets the npm `typescript` 5.9 as its optional peer, because pnpm does not match the prerelease bridge against `<7`; one `typescript` keeps `LanguageServiceHost` and friends identical.
		"paths": { "typescript": ["../node_modules/typescript/lib/typescript.d.ts"] },
		"rootDir": "../services/packages/typescript",
		"emitDeclarationOnly": true,
		"declarationDir": "../node_modules/.services-types/typescript",
		"tsBuildInfoFile": "../node_modules/.services-types/typescript.tsbuildinfo"
	},
	"references": [
		{ "path": "../tsconfig.volar/language-service.json" }
	]
}
