{
	// Type-checks the services submodule with the repo's TypeScript 7 and the services' own options, minus what TS 7 dropped (`esModuleInterop: false`, implicit `@types`).
	// Its runtime JS is emitted by `npm run build:services` (TypeScript 5.9), as the services publish it.
	"extends": "../services/packages/pug-beautify/tsconfig.json",
	"compilerOptions": {
		"esModuleInterop": null,
		"types": ["node"],
		"rootDir": "../services/packages/pug-beautify",
		"emitDeclarationOnly": true,
		"declarationDir": "../node_modules/.services-types/pug-beautify",
		"tsBuildInfoFile": "../node_modules/.services-types/pug-beautify.tsbuildinfo"
	},
	"references": [
		{ "path": "../tsconfig.volar/language-service.json" }
	]
}
