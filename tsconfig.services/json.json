{
	// Type-checks the services submodule with the repo's TypeScript 7 and the services' own options, emitting only declarations for project references.
	// Its runtime JS is emitted by `npm run build:services` (TypeScript 7.1), as the services publish it.
	"extends": "../services/packages/json/tsconfig.json",
	"compilerOptions": {
		"rootDir": "../services/packages/json",
		"emitDeclarationOnly": true,
		"declarationDir": "../node_modules/.services-types/json",
		"tsBuildInfoFile": "../node_modules/.services-types/json.tsbuildinfo"
	},
	"references": [
		{ "path": "../tsconfig.volar/language-service.json" }
	]
}
