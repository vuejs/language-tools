{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"strict": true
	},
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false
			}
		},
		{
			"package": "@vue/content-mapper",
			"extensions": [".md"],
			"options": {
				"format": "vitepress",
				"languageFeatures": false
			}
		}
	],
	"include": ["**/*"]
}
