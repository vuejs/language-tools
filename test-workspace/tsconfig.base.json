{
	"compilerOptions": {
		"lib": [
			"esnext",
			"dom"
		],
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"allowJs": true,
		"declaration": true,
		"noEmit": true,
		"jsx": "preserve"
	},
	"vueCompilerOptions": {
		"target": 99
	},
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false
			}
		}
	],
	"include": []
}
