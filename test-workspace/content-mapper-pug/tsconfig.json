{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"strict": true
	},
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false,
				"target": 99,
				"plugins": ["../../packages/language-plugin-pug"]
			}
		}
	],
	"include": ["App.vue", "Child.vue", "Issues.vue", "Positions.vue"]
}
