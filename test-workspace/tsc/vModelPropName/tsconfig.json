{
	"extends": "../../tsconfig.base.json",
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false,
				"target": 99,
				"vModelPropName": {
					"my-input": "value",
					"MySwitch": "checked",
					"f-radio-field": false
				}
			}
		}
	],
	"include": ["**/*"]
}
