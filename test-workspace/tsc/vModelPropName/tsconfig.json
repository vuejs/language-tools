{
	"extends": "../../tsconfig.base.json",
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false,
				"target": 99,
				"vModelPropName": {
					"value": {
						"my-input": true
					}
				}
			}
		}
	],
	"include": ["**/*"]
}
