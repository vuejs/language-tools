{
	"extends": "../../tsconfig.base.json",
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false
			}
		},
		{
			"package": "@vue/content-mapper",
			"extensions": [".md"],
			"options": {
				"format": "vitepress",
				"languageFeatures": false
			}
		}
	],
	"include": ["**/*"]
}
