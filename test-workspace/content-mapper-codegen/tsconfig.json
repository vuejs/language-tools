{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"checkJs": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"strict": true
	},
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false,
				"target": 99,
				"plugins": ["./plugin.cjs"]
			}
		}
	],
	"include": ["*.vue"]
}
