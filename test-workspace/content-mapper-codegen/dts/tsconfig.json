{
	"extends": "../../tsconfig.base.json",
	"contentMappers": [
		{
			"package": "@vue/content-mapper",
			"extensions": [".vue"],
			"options": {
				"languageFeatures": false,
				"target": 99,
				"plugins": [
					"../plugin.cjs",
					{ "name": "../plugin.cjs", "order": "second" },
					{ "name": "../plugin.cjs", "order": "third" }
				]
			}
		}
	],
	"include": ["*.vue"]
}
