{
	"name": "@vue/content-mapper",
	"version": "4.0.0-alpha.0",
	"license": "MIT",
	"files": [
		"*.d.ts",
		"*.js",
		"lib/**/*.d.ts",
		"lib/**/*.js",
		"README.md"
	],
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/vuejs/language-tools.git",
		"directory": "packages/content-mapper"
	},
	"scripts": {
		"generate-names": "node scripts/generate-names.js"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"server.js"
			],
			"dynamicConfig": true
		}
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-beta"
	},
	"dependencies": {
		"@volar/language-core": "workspace:*",
		"@vue/compiler-dom": "^3.5.0",
		"@vue/language-core": "workspace:*",
		"@vue/shared": "^3.5.0",
		"alien-signals": "^3.2.1",
		"path-browserify": "^1.0.1"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"@types/path-browserify": "^1.0.3",
		"@vue/compiler-sfc": "^3.5.0",
		"typescript": "npm:typescript@7.1.0-beta"
	}
}
