{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// muggle-string is ES modules only, which CommonJS requires from Node 20.19 and 22.12
		"module": "node20",
		"types": [
			"node"
		]
	},
	"references": [
		{ "path": "../../tsconfig.volar/language-core.json" },
		{ "path": "../../tsconfig.muggle-string/muggle-string.json" },
		{ "path": "../language-core/tsconfig.json" }
	],
	"include": ["*.ts", "lib/**/*.ts"],
	"exclude": ["*.spec.ts"]
}
