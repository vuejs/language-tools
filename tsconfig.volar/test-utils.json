{
	// Type-checks the volar.js submodule with the repo's TypeScript 7 and volar.js's own options, emitting only declarations for project references.
	// Its runtime JS is emitted by `npm run build:volar` (TypeScript 7.1), as volar.js publishes it.
	"extends": "../volar.js/packages/test-utils/tsconfig.json",
	"compilerOptions": {
		"rootDir": "../volar.js/packages/test-utils",
		"emitDeclarationOnly": true,
		"declarationDir": "../node_modules/.volar.js-types/test-utils",
		"tsBuildInfoFile": "../node_modules/.volar.js-types/test-utils.tsbuildinfo"
	},
	"references": [
		{ "path": "./language-server.json" }
	]
}
