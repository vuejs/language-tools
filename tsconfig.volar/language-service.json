{
	// Type-checks the volar.js submodule with the repo's TypeScript 7 and volar.js's own options, minus what TS 7 dropped (`esModuleInterop: false`, implicit `@types`).
	// Its runtime JS is emitted by `npm run build:volar` (TypeScript 5.9), as volar.js publishes it.
	"extends": "../volar.js/packages/language-service/tsconfig.json",
	"compilerOptions": {
		"esModuleInterop": null,
		"types": ["node"],
		"rootDir": "../volar.js/packages/language-service",
		"emitDeclarationOnly": true,
		"declarationDir": "../node_modules/.volar.js-types/language-service",
		"tsBuildInfoFile": "../node_modules/.volar.js-types/language-service.tsbuildinfo"
	},
	"references": [
		{ "path": "./language-core.json" }
	]
}
